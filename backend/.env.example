# Copy to .env and fill in. The poller no-ops when these are blank.
HAIKUBOX_API_KEY=
HAIKUBOX_SERIAL=

# Web Push (VAPID). Generate via:
#   docker compose run --rm api python scripts/generate_vapid_keys.py
# That script writes the private key to secrets/vapid_private.pem and prints
# the public key to paste below. Subject must be either a mailto: or https URL.
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:you@example.com

# SFTP server (Reolink uploads motion-triggered JPG snapshots here). Generated
# automatically by scripts/bootstrap_server.sh on first deploy; you copy this
# value into the Reolink camera's FTP settings. The matching SSH host key
# is generated by the atmoz/sftp container and persisted in the sftp_keys
# Docker volume across restarts.
SFTP_PASSWORD=

# Optional: override the default species classifier.
# BIRD_CLASSIFIER_MODEL=dennisjooo/Birds-Classifier-EfficientNetB2
