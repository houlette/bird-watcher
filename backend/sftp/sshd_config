# Custom sshd_config for the atmoz/sftp container.
#
# OpenSSH 10.x dropped several legacy algorithms (CBC ciphers, ssh-rsa
# signature algorithm, diffie-hellman-group14-sha1 KEX) that older IoT
# devices like the Reolink RLC-811WA still use. Without re-enabling them,
# the Reolink can't negotiate a connection at all (silent "Connection
# closed" with no auth attempt). We add them back with `+` prefix so
# modern algorithms remain preferred — legacy is only used when the
# client offers nothing newer.
#
# Security tradeoff: ssh-rsa (RSA + SHA-1) and CBC ciphers are weaker
# than modern equivalents but acceptable for transporting bird-feeder
# snapshots from a camera on the LAN to our cloud VM. No private keys
# or sensitive data crosses this channel.

# === atmoz/sftp defaults — preserve these ===
Protocol 2
HostKey /etc/ssh/ssh_host_ed25519_key
HostKey /etc/ssh/ssh_host_rsa_key
UseDNS no
PermitRootLogin no
X11Forwarding no
AllowTcpForwarding no
Subsystem sftp internal-sftp
ForceCommand internal-sftp
ChrootDirectory %h

# === Legacy-algorithm compatibility for Reolink ===
KexAlgorithms +diffie-hellman-group14-sha1,diffie-hellman-group-exchange-sha1,diffie-hellman-group1-sha1
HostKeyAlgorithms +ssh-rsa
PubkeyAcceptedAlgorithms +ssh-rsa
Ciphers +aes128-cbc,aes192-cbc,aes256-cbc,3des-cbc

# Verbose auth logging so future debugging surfaces "Failed password" /
# "Accepted password" lines instead of bare "Connection closed".
LogLevel VERBOSE
