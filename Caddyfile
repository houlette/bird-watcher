birdwatcher.ryanhoulette.com {
    encode zstd gzip

    # API: proxy to FastAPI container
    handle /api/* {
        reverse_proxy api:8000
    }

    # Media: also served by FastAPI (StaticFiles at /media)
    handle /media/* {
        reverse_proxy api:8000
    }

    # PWA: serve the prebuilt Vite bundle and fall back to index.html for SPA routes
    handle {
        root * /srv/frontend
        try_files {path} /index.html
        file_server
    }
}
